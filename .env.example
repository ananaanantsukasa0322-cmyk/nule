# このファイルをコピーして .env.local を作成し、実際の値を入れてください
# cp .env.example .env.local
#
# 値はSupabaseダッシュボード（Project Settings > API）および
# Anthropic Consoleから取得できます。実際の値は絶対にコミットしないこと。

# Supabase（Project Settings > API で確認）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# セッションCookieのパスワードハッシュ用ソルト（任意の長いランダム文字列）
JWT_SECRET=

# Anthropic API（日報OCR・単価表AI取込で使用）
ANTHROPIC_API_KEY=
